{
  "name": "yacht-dice",
  "version": "1.251.0",
  "description": "주사위 골목 — 윷놀이·요트·너클본즈·라이어·좌중우 5게임 허브. 로컬/AI/온라인(서버 권위형) 멀티플레이 + 데스크톱 앱",
  "author": "jaesung",
  "main": "electron/main.js",
  "scripts": {
    "build": "node scripts/build-inline.js",
    "check:drift": "node scripts/check-drift.js",
    "test:fx": "node scripts/browser-test/verify-fx.js",
    "capture": "node scripts/browser-test/capture.js",
    "start": "node server.js",
    "app": "electron electron/main.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "test:online": "node scripts/online-test.js",
    "test:online2p": "node scripts/browser-test/verify-online.js",
    "test:seotda": "node scripts/seotda-test.js",
    "cap:sync": "node scripts/build-inline.js && npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "test:pace": "node scripts/browser-test/verify-pace.js",
    "audit": "node scripts/browser-test/audit-all.js && node scripts/browser-test/audit-play.js",
    "test:settings": "node scripts/browser-test/verify-settings.js",
    "test:stats": "node scripts/browser-test/verify-stats.js",
    "test:wallet": "node scripts/browser-test/verify-wallet.js",
    "test:shop": "node scripts/browser-test/verify-shop.js",
    "test:items": "node scripts/browser-test/verify-items.js",
    "test:items:online": "node scripts/browser-test/verify-items-online.js",
    "test:hubstats": "node scripts/browser-test/verify-stats.js",
    "test:tutorial": "node scripts/browser-test/verify-tutorial.js",
    "test:items:more": "node scripts/browser-test/verify-items-more.js",
    "audit:ux": "node scripts/browser-test/audit-ux.js",
    "test:onecard": "node scripts/onecard-sim.js",
    "test:onecard:play": "node scripts/browser-test/verify-onecard-play.js",
    "test:oldmaid": "node scripts/oldmaid-sim.js",
    "test:oldmaid:play": "node scripts/browser-test/verify-oldmaid-play.js",
    "test:cardonline": "node scripts/browser-test/verify-card-online.js",
    "backup": "node scripts/backup.js",
    "test:joker": "node scripts/joker-test.js",
    "test:friction": "node scripts/browser-test/verify-friction.js",
    "app:deploy": "bash scripts/app-deploy.sh",
    "test:cardrules": "node scripts/cardrules-test.js",
    "test:setuporder": "node scripts/browser-test/verify-setup-order.js",
    "audit:readable": "node scripts/browser-test/audit-readable.js",
    "audit:online": "node scripts/browser-test/audit-online-entry.js",
    "test:doneevent": "node scripts/browser-test/verify-done-event.js",
    "test:analytics": "node scripts/browser-test/verify-analytics.js",
    "sim:balance": "node scripts/balance-sim.js",
    "test:chars": "node scripts/browser-test/verify-chars.js",
    "phone:cardfx": "node scripts/phone/verify-cardfx.js",
    "perf:yut": "node scripts/browser-test/perf-yut.js",
    "phone:perfyut": "node scripts/phone/perf-yut-phone.js",
    "analytics:status": "node scripts/analytics-toggle.js status",
    "analytics:on": "node scripts/analytics-toggle.js on",
    "analytics:off": "node scripts/analytics-toggle.js off",
    "audit:landscape": "node scripts/browser-test/audit-landscape.js",
    "audit:hub": "node scripts/browser-test/audit-hub.js",
    "test:hostlink": "node scripts/browser-test/verify-host-link.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@capacitor-community/admob": "^6.2.0",
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.jaesung.yachtdice",
    "productName": "Yacht Dice",
    "files": [
      "electron/**/*",
      "public/**/*",
      "server.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    }
  }
}
