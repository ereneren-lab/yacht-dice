# 릴리스 서명 설정 — 이 파일을 keystore.properties로 복사하고 값을 채운다(그 파일은 gitignore됨).
# 키스토어 만들기(한 번):
#   keytool -genkey -v -keystore release.keystore -alias alley -keyalg RSA -keysize 2048 -validity 10000
# ⚠️ release.keystore와 비밀번호를 잃어버리면 같은 앱을 다시 업데이트 못 한다 — 안전하게 백업할 것.
storeFile=../release.keystore
storePassword=CHANGE_ME
keyAlias=alley
keyPassword=CHANGE_ME
